sections:
  - type: grid
    cards:
      - type: custom:button-card
        entity: sensor.sejour_exterieur_temperature
        show_icon: false
        show_name: false
        show_state: false
        styles:
          card:
            - background: transparent
            - border: none
            - box-shadow: none
            - height: 220px
            - padding: 0
            - position: relative
            - overflow: hidden
            - margin-left: "-21px"
            - margin-top: 3px
          custom_fields:
            row1:
              - position: absolute
              - inset: 0
              - width: 100%
              - height: 100%
        custom_fields:
          row1: |
            [[[
              // --- température ---
              const v = parseFloat(entity.state);
              const t = isNaN(v) ? `${entity.state}` : `${v.toFixed(1)}°`;

              // Humidité
              const h = states['sensor.sejour_exterieur_humidite']?.state ?? '—';
              const hNum = Number(h);
              const hTxt = Number.isFinite(hNum) ? Math.round(hNum) : h;

              // --- météo + nuit ---
              const w = states['weather.la_gorgue'];
              const c = w ? w.state : 'unknown';

              const sun = states['sun.sun'];
              const isNight = sun ? (sun.state === 'below_horizon') : false;

              const map = {
                'sunny': 'mdi:weather-sunny',
                'clear-night': 'mdi:weather-night',
                'partlycloudy': 'mdi:weather-partly-cloudy',
                'cloudy': 'mdi:weather-cloudy',
                'overcast': 'mdi:weather-cloudy',
                'fog': 'mdi:weather-fog',
                'hazy': 'mdi:weather-hazy',
                'rainy': 'mdi:weather-rainy',
                'pouring': 'mdi:weather-pouring',
                'lightning': 'mdi:weather-lightning',
                'lightning-rainy': 'mdi:weather-lightning-rainy',
                'snowy': 'mdi:weather-snowy',
                'snowy-rainy': 'mdi:weather-snowy-rainy',
                'windy': 'mdi:weather-windy',
                'windy-variant': 'mdi:weather-windy-variant',
                'hail': 'mdi:weather-hail',
                'exceptional': 'mdi:weather-cloudy-alert'
              };

              const nightMap = {
                'sunny': 'mdi:weather-night',
                'partlycloudy': 'mdi:weather-night-partly-cloudy',
                'cloudy': 'mdi:weather-night-partly-cloudy',
                'overcast': 'mdi:weather-night-partly-cloudy'
              };

              let icon = map[c] || 'mdi:weather-cloudy-alert';
              if (isNight && nightMap[c]) icon = nightMap[c];

              // --- overlay risque pluie/neige/verglas (coin haut droit) ---
              const toPct = (id) => {
                const s = states[id]?.state;
                const n = parseFloat(s);
                return Number.isFinite(n) ? n : null;
              };

              const rain = toPct('sensor.la_gorgue_rain_chance');
              const snow = toPct('sensor.la_gorgue_snow_chance');
              const ice  = toPct('sensor.la_gorgue_freeze_chance');

              const TH = 30; // seuil d'affichage (%). Mets 20 si tu veux plus sensible.

              let riskIcon = '';
              let riskVal = null;

              const consider = (val, iconName) => {
                if (val === null) return;
                if (val < TH) return;
                if (riskVal === null || val > riskVal) {
                  riskVal = val;
                  riskIcon = iconName;
                }
              };

              consider(rain, 'mdi:weather-rainy');
              consider(snow, 'mdi:weather-snowy');
              consider(ice,  'mdi:snowflake-alert');

              const riskHtml = (riskVal !== null) ? `
                <div style="
                  position:absolute;
                  top:8px;
                  right:10px;
                  display:flex;
                  align-items:center;
                  gap:6px;
                  font-size:13px;
                  font-weight:700;
                  color:#000;
                  line-height:1;
                ">
                  <ha-icon icon="${riskIcon}" style="width:20px;height:20px;color:#000;"></ha-icon>
                  ${riskVal.toFixed(0)}%
                </div>
              ` : '';

              // Réglages
              const BAR_W = 8;
              const GAP = 18;

              return `
                <div style="
                  position:relative;
                  height:100%;
                  width:100%;
                  display:grid;
                  grid-template-columns: ${BAR_W}px ${GAP}px 1fr;
                  align-items:center;
                ">

                  ${riskHtml}

                  <!-- BARRE -->
                  <div style="
                    height:200px;
                    width:${BAR_W}px;
                    border-radius:4px;
                    justify-self:start;
                    align-self:center;
                    margin-top:1px;
                    background:
                      radial-gradient(circle, rgba(0,0,0,0.55) 1px, transparent 1.6px)
                      0 0 / 4px 4px;">
                  </div>

                  <div></div>

                  <!-- CONTENU -->
                  <div style="
                    height:90%;
                    display:flex;
                    flex-direction:column;
                    justify-content:space-between;
                    align-items:flex-start;
                    min-width:0;
                  ">

                    <!-- icône météo -->
                    <div style="
                      flex:1;
                      width:135px;
                      display:flex;
                      align-items:center;
                      justify-content:center;
                    ">
                      <ha-icon icon="${icon}" style="width:60px;height:60px;color:#000;"></ha-icon>
                    </div>

                    <!-- bas carte -->
                    <div style="
                      display:flex;
                      flex-direction:column;
                      align-items:flex-start;
                      gap:6px;
                    ">

                      <div style="margin-bottom:1px;font-size:56px;font-weight:600;line-height:1;color:#000;">
                        ${t}
                      </div>

                      <div style="margin-bottom:5px;font-size:15px;font-weight:600;color:#000;">
                        Taux d'humidité ${hTxt}%
                      </div>
                    </div>
                  </div>
                </div>
              `;
            ]]]
        grid_options:
          columns: 6
      - type: custom:apexcharts-card
        card_mod:
          style: |
            ha-card {
              background: transparent;
              border: 0;
              box-shadow: none;
              padding: 0;
              width: calc(100% + 20px);
              transform: translateX(-20px);
              }
        header:
          show: false
        graph_span: 24h
        span:
          end: minute
        apex_config:
          chart:
            height: 220px
            toolbar:
              show: false
            zoom:
              enabled: false
            animations:
              enabled: false
          tooltip:
            enabled: false
          stroke:
            width: 3
            curve: smooth
            lineCap: round
          markers:
            size: 0
          grid:
            padding:
              left: 10
              right: 1
              top: 0
              bottom: 0
          xaxis:
            type: datetime
            tickAmount: 6
            labels:
              datetimeFormatter:
                hour: HH:mm
              hideOverlappingLabels: true
              style:
                colors: "#000"
                fontSize: 12px
          yaxis:
            forceNiceScale: true
            labels:
              formatter: |
                EVAL:function(v){ return Math.round(v) + "°"; }
              style:
                colors: "#000"
                fontSize: 12px
            axisBorder:
              show: false
            axisTicks:
              show: false
        series:
          - entity: sensor.sejour_exterieur_temperature
            name: ""
            color: "#000"
        grid_options:
          columns: 10
      - type: custom:button-card
        show_icon: false
        show_name: false
        show_state: false
        styles:
