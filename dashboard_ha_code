            [[[
              const left = "Station météo Netatmo by DHN";

              // Heure
              const d = new Date();
              const hh = String(d.getHours()).padStart(2,'0');
              const mm = String(d.getMinutes()).padStart(2,'0');
              const right = `La Gorgue (${hh}:${mm})`;

              // Vigilance
              const a = states['sensor.59_weather_alert'];
              const s = a ? String(a.state).toLowerCase() : 'unknown';

              // adapte ici si ton capteur renvoie déjà "Jaune/Orange/Rouge"
              let vig = '';
              if (['yellow','jaune'].includes(s)) vig = 'Jaune';
              else if (['orange'].includes(s)) vig = 'Orange';
              else if (['red','rouge'].includes(s)) vig = 'Rouge';
              else vig = ''; // vert / none => rien

              const center = vig ? `
                <span style="
                  display:flex;
                  align-items:center;
                  gap:6px;
                  white-space:nowrap;
                  font-weight:600;
                ">
                  <ha-icon icon="mdi:alert-outline" style="margin-bottom:5px;width:18px;height:18px;color:#000;"></ha-icon>
                  Vigilance ${vig}
