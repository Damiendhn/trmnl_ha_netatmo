                  width:100%;
                  display:grid;
                  grid-template-columns: auto 1fr auto;
                  align-items:center;
                  font-size:16px;
                  font-weight:500;
                  color:#000;
                ">
                  <span style="white-space:nowrap; display:flex; align-items:center;">${left}</span>

                  <div style="display:flex; justify-content:center;">
                    ${center}
                  </div>

                  <span style="white-space:nowrap;">${right}</span>
                </div>
              `;
            ]]]
