              `;
            ]]]
          row2: |
            [[[
              const h = states['sensor.sejour_humidite']?.state ?? '—';
              return `        <div style="display:flex; align-items:center; gap:12px; width:100%;">
                  <div style="
                    width:8px;
                    height:42px;
                    border-radius:4px;
                    background:
                      radial-gradient(circle, rgba(0,0,0,0.55) 1px, transparent 1.6px)
                      0 0 / 4px 4px;"></div>
              
                <div style="display:flex; align-items:center; gap:12px; width:100%;">
                  <div style="width:32px; display:flex; justify-content:center; align-items:center;">
                    <ha-icon icon="mdi:water-percent" style="width:30px;height:30px;color:black;"></ha-icon>
                  </div>
                  <div style="text-align:left;">
                    <div style="background:black;color:white;font-size:14px;font-weight:600;padding:2px 8px;border-radius:4px;display:inline-block;">
                      Humidité intérieure
                    </div>
                    <div style="color: black; font-size:26px;font-weight:500;line-height:1; margin-top:6px;">
                      ${h}%
                    </div>
                  </div>
                </div>
              `;
            ]]]
          row3: |
            [[[
              const c = states['sensor.sejour_dioxyde_de_carbone']?.state ?? '—';
              return `
                <div style="display:flex; align-items:center; gap:12px; width:100%;">
                  <div style="
                    width:8px;
                    height:42px;
                    border-radius:4px;
                    background:
                      radial-gradient(circle, rgba(0,0,0,0.55) 1px, transparent 1.6px)
                      0 0 / 4px 4px;"></div>
                <div style="display:flex; align-items:center; gap:12px; width:100%;">
                  <div style="width:32px; display:flex; justify-content:center; align-items:center;">
                    <ha-icon icon="mdi:molecule-co2" style="width:30px;height:30px;color:black;"></ha-icon>
                  </div>
                  <div style="text-align:left;">
                    <div style="background:black;color:white;font-size:14px;font-weight:600;padding:2px 8px;border-radius:4px;display:inline-block;">
                      Dioxyde de carbone
                    </div>
                    <div style="color: black; font-size:26px;font-weight:500;line-height:1; margin-top:6px;">
                      ${c} ppm
                    </div>
                  </div>
                </div>
              `;
            ]]]
        grid_options:
          columns: 8
    column_span: 3
  - type: grid
    cards:
      - type: custom:button-card
        show_name: false
        show_icon: false
        show_state: false
        styles:
          card:
            - height: 1px
            - background: rgba(0,0,0,0.2)
            - border: none
            - box-shadow: none
            - padding: 0
            - margin-top: "-18px"
            - margin-bottom: 0px
            - margin-left: 0px
            - margin-right: 0px
        grid_options:
          columns: 24
    column_span: 3
  - type: grid
    cards:
      - type: custom:button-card
        show_icon: false
        show_name: false
        show_state: false
        styles:
          card:
            - background: transparent
            - border: none
            - height: 160px
            - box-shadow: none
            - padding: 0
            - position: relative
            - overflow: hidden
            - margin-left: "-21px"
            - margin-top: "-33px"
          grid:
            - grid-template-areas: |
                "row1"
                "row2"
            - grid-template-rows: 1fr 1fr
            - row-gap: 6px
        custom_fields:
          row1: |
            [[[
              const toNum = (s) => {
                const n = parseInt(s, 10);
                return Number.isFinite(n) ? n : null;
              };

              const qRaw = states['sensor.qualite_globale_la_gorgue']?.state ?? '—';
              const qNum = toNum(qRaw);

              let qTxt = '—';
              if (qNum === 1) qTxt = 'bon';
              else if (qNum === 2) qTxt = 'moyen';
              else if (qNum === 3) qTxt = 'dégradé';
              else if (qNum === 4) qTxt = 'mauvais';
              else if (qNum === 5) qTxt = 'très mauvais';
              else if (qNum === 6) qTxt = 'extrêmement mauvais';
              else if (qNum === 7) qTxt = 'évènement';

              const qVal = (qNum === null) ? '—' : qNum;

              let airDisplay = `${qVal} ${qTxt}`;
              if (qNum !== null && qNum >= 5) {
                airDisplay = `<span style="background:black;color:white;padding:2px 6px;border-radius:4px;">${qVal} ${qTxt}</span>`;
              }

              return `
                <div style="display:flex; align-items:center; gap:12px; width:100%;">
                  <div style="
                    width:8px;
                    height:42px;
                    border-radius:4px;
                    background:
                      radial-gradient(circle, rgba(0,0,0,0.55) 1px, transparent 1.6px)
                      0 0 / 4px 4px;">
                  </div>

                  <div style="display:flex; align-items:center; gap:12px; width:100%;">
                    <div style="width:32px; display:flex; justify-content:center; align-items:center;">
                      <ha-icon icon="mdi:air-filter" style="width:26px;height:26px;color:black;"></ha-icon>
                    </div>

                    <div style="text-align:left;">
                      <div style="color:black;font-size:14px;font-weight:700;">
                        Indice de qualité de l'air
                      </div>
                      <div style="color:black;font-size:23px;font-weight:500;margin-top:6px;">
                        ${airDisplay} <span style="font-size:15px;font-weight:500;"></span> 
                      </div>
                    </div>
                  </div>
                </div>
              `;
            ]]]
          row2: |
            [[[
              // --- MIN/MAX depuis helpers ---
              const sMin = states['input_number.jardin_tmin_mf'];
              const sMax = states['input_number.jardin_tmax_mf'];

              const toNum = (s) => {
                const n = parseFloat(s);
                return Number.isFinite(n) ? n : null;
              };

              const tmin = sMin ? toNum(sMin.state) : null;
              const tmax = sMax ? toNum(sMax.state) : null;

              const fmt = (n) => (n === null ? '—' : n.toFixed(1));

              // --- UV ---
              const uvEnt = states['sensor.la_gorgue_uv'];
              const uvVal = uvEnt ? toNum(uvEnt.state) : null;
              const uvTxt = (uvVal === null) ? '—' : uvVal.toFixed(0);

              let uvLevel = '—';
              if (uvVal !== null) {
                const u = Math.round(uvVal);
                if (u <= 2) uvLevel = 'faible';
                else if (u <= 5) uvLevel = 'modéré';
                else if (u <= 7) uvLevel = 'élevé';
                else if (u <= 10) uvLevel = 'très fort';
                else uvLevel = 'extrême';
              }

              return `
                <div style="display:flex; align-items:center; gap:12px; width:100%;">
                  <div style="
                    width:8px;
                    height:60px;
                    border-radius:4px;
                    background:
                      radial-gradient(circle, rgba(0,0,0,0.55) 1px, transparent 1.6px)
                      0 0 / 4px 4px;">
                  </div>

                  <div style="display:flex; align-items:center; gap:12px; width:100%;">
                    <div style="width:32px; display:flex; justify-content:center; align-items:flex-start;">
                      <ha-icon icon="mdi:sun-thermometer-outline" style="width:30px;height:30px;color:black;margin-right:1px"></ha-icon>
                    </div>

                    <div style="display:flex; flex-direction:column; gap:4px; text-align:left;">
                      <div style="color:black;font-size:14px;font-weight:700;">
                        Prévision pour aujourd'hui
                      </div>

                      <div style="
                        display:flex;
                        align-items:center;
                        gap:5px;
                        font-size:23px;
                        font-weight:500;
                        color:#000;
                      ">
                        <span style="display:flex;align-items:center;gap:4px;">
                          ${fmt(tmin)}°  /
                        </span>
                        <span style="display:flex;align-items:center;gap:4px;">
                          ${fmt(tmax)}°
                        </span>
                      </div>

                      <div style="color:black;font-size:15px;font-weight:500;">
                        Indice UV ${uvTxt} (${uvLevel})
                      </div>
                    </div>
                  </div>
                </div>
              `;
            ]]]
        grid_options:
          columns: 8
      - type: custom:button-card
        show_icon: false
        show_name: false
        show_state: false
        styles:
          card:
            - background: transparent
            - border: none
            - height: 160px
            - box-shadow: none
            - padding: 0
            - position: relative
            - overflow: hidden
            - margin-left: 1px
            - margin-top: "-33px"
          grid:
            - grid-template-areas: |
                "row1"
                "row2"
            - grid-template-rows: 1fr 1fr
            - row-gap: 6px
        custom_fields:
          row1: |
            [[[
              const r = states['sensor.sejour_pluviometre_precipitation_aujourd_hui']?.state ?? '—';
              const rNum = Number(r);

              // format : 0.0 mm si nombre, sinon '—'
              const rTxt = Number.isFinite(rNum) ? (Math.round(rNum * 10) / 10).toFixed(1) : r;

              // unité depuis le capteur si dispo, sinon mm
              const unit = states['sensor.sejour_pluviometre_precipitation_aujourd_hui']?.attributes?.unit_of_measurement ?? 'mm';

              return `
                <div style="display:flex; align-items:center; gap:12px; width:100%;">
                  <div style="
                    width:8px;
                    height:42px;
                    border-radius:4px;
                    background:
                      radial-gradient(circle, rgba(0,0,0,0.55) 1px, transparent 1.6px)
                      0 0 / 4px 4px;">
                  </div>

                  <div style="display:flex; align-items:center; gap:12px; width:100%;">
                    <div style="width:32px; display:flex; justify-content:center; align-items:center;">
                      <ha-icon icon="mdi:weather-rainy" style="width:30px;height:30px;color:black;"></ha-icon>
                    </div>

                    <div style="text-align:left;">
                      <div style="color:black;font-size:14px;font-weight:700;">
                        Précipitation cumulée
                      </div>

                      <div style="color:black;font-size:23px;font-weight:500;margin-top:6px;">
                        ${rTxt} ${unit} <span style="font-size:15px; font-weight:600"></span>
                      </div>
                    </div>
                  </div>
                </div>
              `;
            ]]]
          row2: |
            [[[
              const capRaw = states['sensor.niveau_de_la_cuve_d_eau_de_pluie_en_pourcentage']?.state;
              const capNum = Number(capRaw);
              const capacite = Number.isFinite(capNum) ? Math.max(0, Math.min(100, capNum)) : null;

              // distance en cm
              const distance = states['number.niveau_de_la_cuve_d_eau_de_pluie_en_cm']?.state ?? '—';

              // couleur remplissage
              const color ='#555';

              const width = capacite === null ? 0 : capacite;

              return `
                <div style="display:flex; align-items:center; gap:12px; width:100%;">

                  <div style="
                    width:8px;
                    height:60px;
                    border-radius:4px;
                    background:
                      radial-gradient(circle, rgba(0,0,0,0.55) 1px, transparent 1.6px)
                      0 0 / 4px 4px;">
                  </div>

                  <div style="display:flex; align-items:center; gap:12px; width:100%;">

                    <div style="width:32px; display:flex; justify-content:center; align-items:center;">
                      <ha-icon icon="mdi:propane-tank-outline" style="width:30px;height:30px;color:black;"></ha-icon>
                    </div>

                    <div style="display:flex; flex-direction:column; gap:6px; text-align:left; width:100%;">

                      <div style="color:black;font-size:14px;font-weight:700;">
                        Réserve eau de pluie
                      </div>

                      <div style="font-size:23px;font-weight:500;color:black; line-height:1;">
                        ${capacite === null ? '—' : `${capacite}%`}
                      </div>

                      <!-- Jauge (sans animation) -->
                      <div style="
                        width: 165px;
                        height: 6px;
                        border: 1px solid #000;
                        border-radius: 999px;
                        background: transparent;
                        position: relative;
                        overflow: hidden;
                        margin-top: 5px;
                        margin-bottom: 5px;
                      ">
                        <div style="
                          width: ${width}%;
                          height: 100%;
                          border-radius: 999px;
                          background: ${color};
                        "></div>
                      </div>

                    </div>

                  </div>
                </div>
              `;
            ]]]
        grid_options:
          columns: 8
      - type: custom:button-card
        show_icon: false
        show_name: false
        show_state: false
        styles:
          card:
            - background: transparent
            - border: none
            - height: 160px
            - box-shadow: none
            - padding: 0
            - position: relative
            - overflow: hidden
            - margin-left: 24px
            - margin-top: "-33px"
          grid:
            - grid-template-areas: |
                "row1"
                "row2"
            - grid-template-rows: 1fr 1fr
            - row-gap: 6px
        custom_fields:
          row1: |
            [[[
              const p = states['sensor.sejour_pression_atmospherique']?.state
                ?? states['sensor.sejour_pression']?.state
                ?? '—';

              const pNum = Number(p);
              const pTxt = Number.isFinite(pNum) ? Math.round(pNum) : p;

              return `
                <div style="display:flex; align-items:center; gap:12px; width:100%;">
                  <div style="
                    width:8px;
                    height:42px;
                    border-radius:4px;
                    background:
                      radial-gradient(circle, rgba(0,0,0,0.55) 1px, transparent 1.6px)
                      0 0 / 4px 4px;">
                  </div>

                  <div style="display:flex; align-items:center; gap:12px; width:100%;">
                    <div style="width:30px; display:flex; justify-content:center; align-items:center;">
                      <ha-icon icon="mdi:gauge-low" style="width:28px;height:28px;color:black;"></ha-icon>
                    </div>

                    <div style="text-align:left;">
                      <div style="color:black;font-size:14px;font-weight:700;">
                        Pression atmosphérique
                      </div>
                      <div style="color:black;font-size:23px;font-weight:500;margin-top:6px;">
                        ${pTxt} hPa
                      </div>
                    </div>
                  </div>
                </div>
              `;
            ]]]
          row2: |
            [[[
              const ws = states['sensor.sejour_anemometre_vitesse_du_vent']?.state ?? '—';
              const wg = states['sensor.vent_vitesse_maximum_24h']?.state ?? '—';

              // direction: ton capteur "angle" + fallback possible
              const wd = states['sensor.sejour_anemometre_angle_du_vent']?.state
                ?? states['sensor.sejour_anemometre_direction_du_vent']?.state
                ?? '—';

              const wsNum = Number(ws);
              const wgNum = Number(wg);
              const wdNum = Number(wd);

              const wsTxt = Number.isFinite(wsNum) ? Math.round(wsNum) : ws;
              const wgTxt = Number.isFinite(wgNum) ? Math.round(wgNum) : wg;

              function degToCardinal(d) {
                if (!Number.isFinite(d)) return '—';
                const dirs = ['Nord','Nord-Est','Est','Sud-Est','Sud','Sud-Ouest','Ouest','Nord-Ouest'];
                return dirs[Math.round(d / 45) % 8];
              }
              const wdTxt = degToCardinal(wdNum);

              const wsUnit = states['sensor.sejour_anemometre_vitesse_du_vent']?.attributes?.unit_of_measurement ?? '';
              const wgUnit = states['sensor.sejour_anemometre_force_des_rafales']?.attributes?.unit_of_measurement ?? wsUnit;

              return `
                <div style="display:flex; align-items:center; gap:12px; width:100%;">
                  <div style="
                    width:8px;
                    height:60px;
                    border-radius:4px;
                    background:
                      radial-gradient(circle, rgba(0,0,0,0.55) 1px, transparent 1.6px)
                      0 0 / 4px 4px;">
                  </div>

                  <div style="display:flex; align-items:center; gap:12px; width:100%;">
                    <div style="width:30px; display:flex; justify-content:center; align-items:flex-start;">
                      <ha-icon icon="mdi:weather-windy" style="width:28px;height:28px;color:black;"></ha-icon>
                    </div>

                    <div style="display:flex; flex-direction:column; gap:4px; text-align:left;">
                      <div style="color:black;font-size:14px;font-weight:700;">
                        Anémomètre
                      </div>

                      <div style="color:black;font-size:23px;font-weight:500;">
                        ${wsTxt}${wsUnit ? ` ${wsUnit}` : ''} 
                      <span style="font-size:15px; font-weight:500">
                      (${wgTxt}${wgUnit ? ` ${wgUnit}` : ''})
                      </span>
                      </div>

                      <div style="color:black;font-size:15px;font-weight:500;">
                        Direction ${wdTxt}
                      </div>
                    </div>
                  </div>
                </div>
              `;
            ]]]
        grid_options:
          columns: 8
    column_span: 3
